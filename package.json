{
  "name": "modeler",
  "private": true,
  "version": "0.1.0",
  "description": "Master maintenance screen development tool (model-driven CRUD generator)",
  "workspaces": [
    "shared",
    "server",
    "client",
    "e2e"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "clean": "rm -rf shared/dist server/dist client/dist client/tsconfig.tsbuildinfo",
    "build": "npm run clean && npm run build --workspace=shared && npm run build --workspace=server && npm run build --workspace=client",
    "test": "npm run test --workspace=shared && npm run test --workspace=server && npm run test --workspace=client",
    "test:server": "npm run test --workspace=server",
    "test:client": "npm run test --workspace=client",
    "test:e2e": "npm run test --workspace=e2e",
    "test:e2e:chromium": "npm run test:chromium --workspace=e2e",
    "test:e2e:firefox": "npm run test:firefox --workspace=e2e",
    "test:e2e:webkit": "npm run test:webkit --workspace=e2e",
    "test:e2e:ui": "npm run test:ui --workspace=e2e"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}